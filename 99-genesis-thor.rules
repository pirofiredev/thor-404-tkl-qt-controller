# Genesis Thor 404 TKL Keyboard (and compatible boards)
# Vendor ID: 0x331A
# Product IDs: 0x501B (Variant A), 0x501C (Variant B)

# Grant read/write access to non-root users via hidraw
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="331a", ATTRS{idProduct}=="501b", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="331a", ATTRS{idProduct}=="501c", MODE="0666", TAG+="uaccess"

# Grant read/write access via usb device node
SUBSYSTEM=="usb", ATTRS{idVendor}=="331a", ATTRS{idProduct}=="501b", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="331a", ATTRS{idProduct}=="501c", MODE="0666", TAG+="uaccess"
